rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBoundedStringList(arr, maxLen) {
      return arr is list
        && arr.size() <= maxLen
        && (arr.size() == 0 || (arr[0] is string && arr[0].size() >= 1 && arr[0].size() <= 32));
    }

    function isValidFoodMap(foodMap) {
      return foodMap is map && foodMap.size() <= 10;
    }

    function isValidPlayerProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'tunicColor',
          'level',
          'xp',
          'gold',
          'swordTier',
          'armorTier',
          'agilityTier',
          'pvpKills',
          'deaths',
          'discoveredBiomes',
          'lastX',
          'lastZ',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'tunicColor',
          'playerClass',
          'classWeaponUnlocked',
          'yetiRuneUnlocked',
          'desertArenaProgress',
          'hasHorse',
          'level',
          'xp',
          'gold',
          'swordTier',
          'armorTier',
          'agilityTier',
          'pvpKills',
          'deaths',
          'discoveredBiomes',
          'ownedWeapons',
          'equippedWeaponId',
          'ownedArmors',
          'equippedArmorId',
          'foodInventory',
          'ownedShips',
          'activeShipId',
          'convoyTier',
          'lastX',
          'lastZ',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 24
        && data.tunicColor is string
        && data.tunicColor.size() == 7
        && data.tunicColor.matches('^#[0-9a-fA-F]{6}$')
        && (!('playerClass' in data) || (data.playerClass is string && data.playerClass in ['guardian', 'archer', 'lancer', 'bomber', 'mage', 'assassin', 'fishman', 'yeti', 'berserker']))
        && (!('classWeaponUnlocked' in data) || data.classWeaponUnlocked is bool)
        && (!('yetiRuneUnlocked' in data) || data.yetiRuneUnlocked is bool)
        && (!('desertArenaProgress' in data) || (data.desertArenaProgress is int && data.desertArenaProgress >= 0 && data.desertArenaProgress <= 5))
        && (!('hasHorse' in data) || data.hasHorse is bool)
        && data.level is int
        && data.level >= 1
        && data.level <= 1200
        && data.xp is int
        && data.xp >= 0
        && data.xp <= 50000000
        && data.gold is int
        && data.gold >= 0
        && data.gold <= 50000000
        && data.swordTier is int
        && data.swordTier >= 1
        && data.swordTier <= 10
        && data.armorTier is int
        && data.armorTier >= 1
        && data.armorTier <= 10
        && data.agilityTier is int
        && data.agilityTier >= 1
        && data.agilityTier <= 10
        && data.pvpKills is int
        && data.pvpKills >= 0
        && data.pvpKills <= 1000000
        && data.deaths is int
        && data.deaths >= 0
        && data.deaths <= 1000000
        && isBoundedStringList(data.discoveredBiomes, 16)
        && (!('ownedWeapons' in data) || isBoundedStringList(data.ownedWeapons, 18))
        && (!('equippedWeaponId' in data) || (data.equippedWeaponId is string && data.equippedWeaponId.size() >= 1 && data.equippedWeaponId.size() <= 32))
        && (!('ownedArmors' in data) || isBoundedStringList(data.ownedArmors, 12))
        && (!('equippedArmorId' in data) || (data.equippedArmorId is string && data.equippedArmorId.size() >= 1 && data.equippedArmorId.size() <= 32))
        && (!('foodInventory' in data) || isValidFoodMap(data.foodInventory))
        && (!('ownedShips' in data) || isBoundedStringList(data.ownedShips, 4))
        && (!('activeShipId' in data) || (data.activeShipId is string && data.activeShipId.size() <= 16))
        && (!('convoyTier' in data) || (data.convoyTier is int && data.convoyTier >= 1 && data.convoyTier <= 10))
        && data.lastX is number
        && data.lastX >= -1900
        && data.lastX <= 1900
        && data.lastZ is number
        && data.lastZ >= -1900
        && data.lastZ <= 1900
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidPlayerProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidPlayerProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'tunicColor',
            'playerClass',
            'classWeaponUnlocked',
            'yetiRuneUnlocked',
            'desertArenaProgress',
            'hasHorse',
            'level',
            'xp',
            'gold',
            'swordTier',
            'armorTier',
            'agilityTier',
            'pvpKills',
            'deaths',
            'discoveredBiomes',
            'ownedWeapons',
            'equippedWeaponId',
            'ownedArmors',
            'equippedArmorId',
            'foodInventory',
            'ownedShips',
            'activeShipId',
            'convoyTier',
            'lastX',
            'lastZ',
            'updatedAt'
          ])
        );

      allow delete: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId);
    }
  }
}
